# Подключение к PostgreSQL. Спецсимволы в пароле кодировать percent-encoding.
DATABASE_URL="postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5432/ИМЯ_БАЗЫ?schema=public"

# Отдельная база ТОЛЬКО для автотестов. Тесты очищают таблицы,
# поэтому направлять их на рабочую базу нельзя.
DATABASE_URL_TEST="postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5432/ИМЯ_БАЗЫ_test?schema=public"

# Базовый адрес сайта. На проде — реальный домен, не localhost.
BASE_URL="http://localhost:7622"

# Каталог хранения загруженных файлов. Должен быть ВНЕ frontend/,
# иначе пересборка Next.js его затрёт.
MEDIA_ROOT="../media"

# Секрет подписи сессий. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET="ЗАМЕНИТЬ_НА_СЛУЧАЙНУЮ_СТРОКУ"

# Должен ПОЛНОСТЬЮ совпадать с BASE_URL, иначе better-auth отвергает вход
# по origin check непонятным образом.
BETTER_AUTH_URL="http://localhost:7622"

# Обязательна ТОЛЬКО в проде (NODE_ENV=production). Подтверждает, что
# обратный прокси перед приложением перезаписывает заголовок X-Real-IP
# настоящим адресом клиента (см. README, раздел про прокси и рейт-лимит
# входа). Не выставляйте "true", пока прокси не настроен именно так —
# в противном случае рейт-лимит входа делится на всех посетителей сразу,
# и вход в панель управления можно заблокировать для владелицы, зная
# только адрес страницы входа. Локально не задавайте вообще.
# TRUST_PROXY_SETS_CLIENT_IP="true"
